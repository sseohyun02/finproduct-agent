{
  "설명": "HyperCLOVA가 질문을 변환해 뱉는 구조화된 의도 JSON 스키마. 쿼리빌더의 입력 계약. LLM은 이 형식만 채우고, 실제 쿼리 생성은 query_builder.py가 담당(환각 방지).",
  "스키마": {
    "product_scope": {
      "설명": "대상 상품군. 질문에서 명시되면 지정, 없으면 자동추론 또는 all",
      "타입": "enum",
      "값": [
        "bond",
        "etf_domestic",
        "etf_overseas",
        "fund",
        "etf",
        "all"
      ],
      "비고": "이전 단일 상품군 입력 호환용. 신규 출력은 product_scopes 사용. etf는 기존 계약상 국내 기본."
    },
    "graph_conditions": {
      "설명": "그래프(관계) 순회가 필요한 조건들. 없으면 빈 배열. 이게 있으면 SPARQL 경유",
      "타입": "array",
      "항목": {
        "relation": {
          "타입": "enum",
          "값": [
            "holds",
            "hasTheme",
            "belongsToGroup",
            "issuedBy",
            "sameGroupAs"
